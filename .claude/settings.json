{
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue edit:*)",
      "Bash(rm -rf:*)",
      "Edit(factory/**)",
      "Write(factory/**)"
    ]
  }
}
